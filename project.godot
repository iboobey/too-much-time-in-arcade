; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Too Much Time In Arcade"
run/main_scene="uid://ovnbuimm0oaa"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*uid://dtqfux22o87l0"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/quality/msaa_2d=0

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[global_group]

InteractionComponent="InteractionComponent"
Player="Player"
Snake="SnakeBody"
SnakeApple=""

[importer_defaults]

font_data_dynamic={
&"antialiasing": 0
}

